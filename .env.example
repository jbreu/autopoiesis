# Create .env with: python3 scripts/init_env.py
# Runtime secrets and tokens belong only in the ignored .env file.
AGENT_CANVAS_IMAGE=ghcr.io/openhands/agent-canvas:1.20.0
AGENT_PORT=8000
AGENT_UID=1000
AGENT_GID=1000
LOCAL_BACKEND_API_KEY=change-me
OH_SECRET_KEY=change-me
AGENT_GIT_NAME="AI Development Bot"
AGENT_GIT_EMAIL=ai-dev-bot@example.invalid
# Optional: repository-scoped token for HTTPS Git and GitHub CLI.
# Required repository permissions: Contents: write, Pull requests: write.
GH_TOKEN=
