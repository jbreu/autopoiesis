{
  "name": "Autopoiesis",
  "dockerComposeFile": "../compose.yaml",
  "service": "agent",
  "workspaceFolder": "/projects/app",
  "remoteUser": "openhands",
  "updateRemoteUserUID": false,
  "overrideCommand": false,
  "shutdownAction": "none",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/opt/poc-tools/bin/python",
        "ruff.configuration": "/projects/app/.autopoiesis/ruff.toml"
      }
    }
  }
}
